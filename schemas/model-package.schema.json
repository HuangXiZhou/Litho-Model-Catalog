{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HuangXiZhou/Litho-Model-Catalog/main/schemas/model-package.schema.json",
  "title": "Model package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageID",
    "displayName",
    "modelID",
    "sourceURL",
    "sourceRevision",
    "revision",
    "minimumMemoryGB",
    "adapterVersion",
    "quantization",
    "tasks",
    "languages",
    "license",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "modelID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,200}$"
    },
    "sourceURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "minimumMemoryGB": {
      "type": "integer",
      "minimum": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "quantization": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "url",
        "byteCount",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.)[A-Za-z0-9._/-]+$"
        },
        "kind": {
          "enum": [
            "weights",
            "tokenizer",
            "license",
            "notice",
            "sbom",
            "conversionNotes"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "mirrors": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 137438953472
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "weights"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.(safetensors|gguf)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tokenizer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.(json|model|vocab|tiktoken|merges|txt)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "license",
                  "notice"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.(txt|md|html)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sbom"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.(json|spdx|txt)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "conversionNotes"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.(txt|md|json)$"
              }
            }
          }
        }
      ]
    }
  }
}
