{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HuangXiZhou/Litho-Model-Catalog/main/schemas/signed-model-package.schema.json",
  "title": "Signed model package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keyID",
    "signature",
    "manifest"
  ],
  "properties": {
    "keyID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "manifest": {
      "$ref": "model-package.schema.json"
    }
  }
}
